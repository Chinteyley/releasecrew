# Required for live neatlogs export. Without it, ReleaseCrew still records
# local JSON traces under evidence/neatlogs/ and .releasecrew/runs/<id>/trace.jsonl
NEATLOGS_API_KEY=

# Optional EU ingest override
# NEATLOGS_ENDPOINT=https://eu.ingest.neatlogs.com

# At least one model key unlocks the LLM writer/planner. Without any key the
# pipeline still runs using the heuristic fallback (GitHub-grounded templates).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# LiteLLM (neatHack shared key) — OpenAI-compatible
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
# neatHack models: nova-micro nova-lite nova-pro nova-2-lite claude-haiku claude-sonnet-4.6 claude-opus-4.6
# Amazon Bedrock via the AI SDK (hackathon AWS accounts do not include Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Optional GitHub token. Public repos work unauthenticated; a token raises the rate limit.
GITHUB_TOKEN=

# Optional model override, e.g. gpt-4o-mini, claude-sonnet-4-5, openai/gpt-4o-mini
RELEASECREW_MODEL=
